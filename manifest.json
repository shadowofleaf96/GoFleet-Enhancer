{
  "manifest_version": 3,
  "name": "GoFleet Enhancer",
  "description": "Professional tool for barcode scanning workflow optimization with seamless data export capabilities. Maintains input focus while allowing text operations and provides one-click Excel exports.",
  "version": "1.0",
  "permissions": [
    "clipboardWrite",
    "activeTab",
    "scripting",
    "storage",
    "activeTab",
    "downloads",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dummy-content/*",
        "xlsx.full.min.js",
        "xlsx-populate.min.js",
        "content.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
